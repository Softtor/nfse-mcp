# Ambiente: production | homologation | homologation_fictitious
NFSE_ENVIRONMENT=homologation

# Certificado Digital A1 (PFX/PKCS12)
NFSE_CERTIFICATE_PATH=/caminho/local/para/certificado.p12
NFSE_CERTIFICATE_PASSWORD=sua-senha-do-certificado

# Dados do Prestador (ajustar para sua empresa)
NFSE_PROVIDER_CNPJ=00000000000000
NFSE_PROVIDER_IM=0000000000000
NFSE_PROVIDER_RAZAO_SOCIAL=RAZAO SOCIAL DA EMPRESA LTDA
NFSE_PROVIDER_SIMPLES_NACIONAL=1     # 1=Sim, 2=Não
NFSE_PROVIDER_ALIQUOTA_SIMPLES=6.00  # % aproximado de tributos do Simples (NFS-e nacional, pTotTribSN)
NFSE_PROVIDER_REGIME_TRIBUTACAO=6    # 6=ME/EPP
NFSE_PROVIDER_INCENTIVO_FISCAL=2     # 2=Não

# Defaults do Serviço (ajustar à sua atividade)
NFSE_DEFAULT_CNAE=6209100
NFSE_DEFAULT_ITEM_LISTA_SERVICO=1.07
NFSE_DEFAULT_CODIGO_TRIBUTACAO_MUNICIPIO=107
NFSE_DEFAULT_ALIQUOTA=2.00
NFSE_DEFAULT_MUNICIPIO_IBGE=5300108  # Brasília
NFSE_DEFAULT_ISS_RETIDO=2            # 2=Não retido
NFSE_DEFAULT_EXIGIBILIDADE_ISS=1     # 1=Exigível

# Série RPS (3=produção, 8=homologação)
NFSE_RPS_SERIE=8

# ============================================================================
# SEFIN Nacional NFS-e (API REST — padrão nacional)
# ============================================================================
# Ambiente: production | production_restricted
SEFIN_ENVIRONMENT=production_restricted

# Certificado Digital A1 (PFX/PKCS12) — pode reutilizar NFSE_CERTIFICATE_PATH
# ou usar SEFIN_CERTIFICATE_PATH se for diferente
# SEFIN_CERTIFICATE_PATH=/caminho/local/para/certificado.p12
# SEFIN_CERTIFICATE_PASSWORD=sua-senha-do-certificado

# Debug e validação
SEFIN_DEBUG=false
SEFIN_SKIP_XSD_VALIDATION=false

# Timeouts e retries
SEFIN_TIMEOUT=60
SEFIN_MAX_RETRIES=3
